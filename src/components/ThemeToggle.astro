<button type="button" class="theme-toggle" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>
<noscript><style>.theme-toggle { display: none; }</style></noscript>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--heading);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
  }
  .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-sun { display: block; }
  :global([data-theme='dark']) .icon-moon { display: none; }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme';
  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(initThemeToggle);
</script>

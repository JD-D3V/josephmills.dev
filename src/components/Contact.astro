---
import { site } from '../data/site';
import SectionHeader from './SectionHeader.astro';

const kindLabel = { email: 'Email', phone: 'Phone', linkedin: 'LinkedIn', github: 'GitHub' } as const;
---

<section id="contact" class="section container" aria-labelledby="contact-title">
  <SectionHeader id="contact" label="Contact" title="Let's build something." intro={site.contact.blurb} />
  <div class="actions">
    <a class="btn btn--primary" href={`mailto:${site.contact.email}`}>Email me</a>
    {site.resume && <a class="btn btn--ghost" href={site.resume}>Download résumé</a>}
  </div>
  <ul class="rows">
    {site.contact.links.map((l) => (
      <li class="card row">
        <span class="row__kind">{kindLabel[l.kind]}</span>
        <a href={l.href} target={l.kind === 'email' || l.kind === 'phone' ? undefined : '_blank'} rel={l.kind === 'email' || l.kind === 'phone' ? undefined : 'noopener'}>{l.label}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; max-width: 560px; }
  .row { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; padding: 16px 20px; }
  .row__kind { font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); min-width: 80px; }
</style>

---
import type { GalleryItem } from '../scripts/gallery';

interface Props {
  projectId: string;
  title: string;
  items: GalleryItem[];
}
const { projectId, title, items } = Astro.props;
const json = JSON.stringify(items).replace(/</g, '\\u003c');
---

<dialog class="gallery" data-gallery-dialog={projectId} aria-label={`${title} gallery`}>
  <div class="gallery__bar">
    <span class="gallery__counter" aria-live="polite"></span>
    <button type="button" class="gallery__close" aria-label="Close gallery">✕</button>
  </div>
  <div class="gallery__main">
    <button type="button" class="gallery__nav gallery__prev" aria-label="Previous item">‹</button>
    <div class="gallery__stage"></div>
    <button type="button" class="gallery__nav gallery__next" aria-label="Next item">›</button>
  </div>
  <p class="gallery__caption"></p>
  <script type="application/json" data-gallery-items={projectId} set:html={json} />
</dialog>

<style is:global>
  .gallery { padding: 0; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-raised); color: var(--text); width: min(1100px, 96vw); max-width: 96vw; max-height: 94vh; overflow: hidden; }
  .gallery[open] { display: flex; flex-direction: column; }
  .gallery::backdrop { background: rgba(0, 0, 0, 0.75); }
  .gallery__bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 8px 8px 16px; font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; }
  .gallery__main { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 4px; min-height: 0; }
  .gallery__stage { display: grid; place-items: center; min-width: 0; min-height: 200px; }
  .gallery__stage img, .gallery__stage video { max-width: 100%; max-height: 70vh; object-fit: contain; border-radius: 8px; }
  .gallery__stage iframe { width: 100%; aspect-ratio: 16 / 9; max-height: 70vh; border: 0; border-radius: 8px; }
  .gallery__yt { position: relative; display: block; padding: 0; border: 0; background: none; cursor: pointer; max-width: 100%; }
  .gallery__yt img { display: block; }
  .gallery__yt-glyph { position: absolute; inset: 0; display: grid; place-items: center; font-size: 3rem; color: #fff; background: rgba(0, 0, 0, 0.3); border-radius: 8px; }
  .gallery__caption { margin: 0; padding: 12px 16px 16px; text-align: center; color: var(--muted); font-size: 0.9375rem; }
  .gallery__nav, .gallery__close { width: 44px; height: 44px; display: grid; place-items: center; font-size: 1.5rem; line-height: 1; color: var(--heading); background: transparent; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; }
  .gallery__nav[hidden] { display: none; }
  @media (max-width: 599px) {
    .gallery__nav { width: 36px; height: 36px; }
  }
</style>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>

---
import { site } from '../data/site';
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
---

<section id="experience" class="section container" aria-labelledby="experience-title">
  <SectionHeader id="experience" label="Experience" title="Where I've worked" />
  <div class="jobs">
    {site.experience.map((job) => (
      <article class="card job">
        <div class="job__head">
          <h3>{job.role}</h3>
          <p class="job__dates">{job.dates}</p>
        </div>
        <p class="job__org">{job.org} · {job.place}</p>
        <ul>
          {job.bullets.map((b) => <li>{b}</li>)}
        </ul>
        {job.photo && (
          <figure class="job__photo">
            <Image src={job.photo.image} alt={job.photo.alt} width={800} widths={[480, 800, 1200]} sizes="(min-width: 900px) 800px, calc(100vw - 80px)" format="webp" loading="lazy" />
            {job.photo.credit && <figcaption>Photo: {job.photo.credit}</figcaption>}
          </figure>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .jobs { display: grid; gap: 20px; }
  .job__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 24px; align-items: baseline; }
  .job h3 { font-size: 1.25rem; margin: 0; min-width: 0; }
  .job__dates { margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 0.8125rem; color: var(--muted); }
  .job__org { margin: 4px 0 16px; color: var(--muted); font-style: italic; }
  ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .job__photo { margin: 20px 0 0; }
  .job__photo :global(img) { display: block; width: 100%; max-width: 560px; height: auto; border-radius: 12px; border: 1px solid var(--border); }
  .job__photo figcaption { margin-top: 8px; font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--muted); }
</style>

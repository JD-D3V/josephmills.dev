{
  "name": "josephmills-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio site for Joseph Mills — josephmills.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JD-D3V/josephmills.dev.git"
  },
  "homepage": "https://josephmills.dev",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321 --ignore-lock",
    "check": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:links": "linkinator dist --recurse --check-fragments --skip \"linkedin\\\\.com|^https://josephmills\\\\.dev\"",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:links && npm run test:lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
